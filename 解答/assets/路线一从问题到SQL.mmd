flowchart TD
    A0(["阶段一：提问前，先建设业务语言"]) --> A["数据库表头<br/>BI SQL / 看板 / 日志 / dbt"]
    A --> B["生成模型骨架<br/>表、字段、类型、主外键"]
    B --> C["补充业务含义<br/>指标口径、维度、同义词、关系、权限"]
    C --> D["稳定的 Cube / MDL<br/>进入版本管理，不随问题临时改变"]

    Q0(["阶段二：每次提问，只生成这一次的点菜单"]) --> Q["用户问题<br/>ORG_1001 上半年各产品的订货金额和利润"]
    Q --> R["按权限从 Cube / MDL<br/>检索相关语义对象"]
    D --> R
    R --> I["问题理解<br/>指标、分组、时间、过滤条件"]
    I --> V{"对象存在、权限允许、没有歧义？"}
    V -->|"否"| X["询问用户或拒绝执行"]
    V -->|"是"| S["查询 DSL<br/>Cube JSON / query_cube"]
    S --> E["语义引擎读取固定指标公式"]
    D --> E
    E --> P["参数化数据库 SQL"]
    P --> O["查询结果"]
