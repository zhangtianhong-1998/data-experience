  },
  {
    "id": "jargon:设备订货",
    "type": "jargon",
    "name": "设备订货",
    "explanation": "设备产品订单，不是 sales_orders 中的销售收入；使用 device_orders。"
  },
  {
    "id": "jargon:设备订货金额",
    "type": "jargon",
    "name": "设备订货金额",
    "explanation": "confirmed 设备订单的 order_amount 合计，单位 CNY。"
  },
  {
    "id": "jargon:设备利润",
    "type": "jargon",
    "name": "设备利润",
    "explanation": "与设备订货金额同口径订单的 profit_amount 合计，单位 CNY。"
  },
  {
    "id": "jargon:上半年",
