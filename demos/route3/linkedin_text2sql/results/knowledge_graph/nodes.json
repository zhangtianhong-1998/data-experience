  {
    "id": "glossary:设备订货金额",
    "type": "glossary",
    "name": "设备订货金额",
    "definition": "已确认设备订货单的 order_amount 合计。",
    "sql_expression": "SUM(device_orders.order_amount)",
    "required_filters": [
      "device_orders.status = 'confirmed'",
      "显式 org_code"
    ],
    "unit": "CNY",
    "owner": "device_analytics"
  },
  {
    "id": "glossary:产品一级分类",
